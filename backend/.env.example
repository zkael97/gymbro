# GymBro Backend Environment Configuration
# Copy file ini ke .env lalu sesuaikan dengan konfigurasi PostgreSQL Anda

# ── PostgreSQL Connection ──────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/gymbro?sslmode=disable

# ── Optional: Port backend ───────────────────────────────────────────────────
PORT=8080

# ── CORS: Allowed Frontend Origins (comma-separated) ────────────────────────
# Kosongkan / hapus untuk mode dev (izinkan semua origin).
# ALLOWED_ORIGINS=http://localhost:4200,https://your-gymbro-app.vercel.app

