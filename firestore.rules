rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // Documents are keyed by lowercase username.
    // Cloud Functions / Firebase Admin SDK bypasses these rules for server actions.
    // Client SDK direct access constraints:
    match /users/{userId} {
      // Users can only read their own profile; cannot list all users
      allow read: if isOwner(userId);
      // Deny direct write from client SDK (passwords must be hashed via Cloud Function)
      allow write: if false;
    }

    // GYM MOVES COLLECTION
    match /gym_moves/{moveId} {
      // Any authenticated user can read public/seed moves or their own custom moves
      allow read: if resource.data.username == null 
                  || resource.data.username == "" 
                  || (isAuthenticated() && request.auth.token.name == resource.data.username);

      // Creating a move: must be authenticated and valid fields
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.type in ['upper', 'lower']
                    && request.resource.data.category is string;

      // Update / Delete: only owner
      allow update, delete: if isAuthenticated() 
                            && resource.data.username != null 
                            && resource.data.username != ""
                            && request.auth.token.name == resource.data.username;
    }

    // WORKOUT LOGS COLLECTION
    match /workout_logs/{logId} {
      // Reading logs: only owner
      allow read: if isAuthenticated() && request.auth.token.name == resource.data.username;

      // Creating logs: owner and valid schema
      allow create: if isAuthenticated() 
                    && request.resource.data.moveTitle is string
                    && request.resource.data.reps is list
                    && request.resource.data.reps.size() > 0
                    && request.auth.token.name == request.resource.data.username;

      // Update / Delete: only owner
      allow update, delete: if isAuthenticated() && request.auth.token.name == resource.data.username;
    }
  }
}
