rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS COLLECTION
    // Keyed by lowercase username
    match /users/{userId} {
      // Allow reading user document for login validation
      allow read: if true;
      // Allow creating user (registration) and updating password (forgot-password)
      allow create, update: if request.resource.data.username is string
                            && request.resource.data.passwordHash is string;
      allow delete: if false;
    }

    // GYM MOVES COLLECTION
    match /gym_moves/{moveId} {
      // Anyone can read public moves (username == null / empty) or user-created moves
      allow read: if true;

      // Allow creating new moves with required fields
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.type in ['upper', 'lower']
                    && request.resource.data.category is string;

      allow update, delete: if true;
    }

    // WORKOUT LOGS COLLECTION
    match /workout_logs/{logId} {
      // Reading logs: allowed
      allow read: if true;

      // Creating logs with required schema
      allow create: if request.resource.data.moveTitle is string
                    && request.resource.data.reps is list
                    && request.resource.data.reps.size() > 0;

      allow update, delete: if true;
    }
  }
}
