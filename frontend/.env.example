# GymBro Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# File environment disimpan di:
#   src/environments/environment.ts        → development (localhost)
#   src/environments/environment.prod.ts   → production  (Railway backend)
#
# Angular melakukan file replacement saat build production secara otomatis.
# Ubah apiUrl di environment.prod.ts dengan URL Railway backend kamu:
#
#   apiUrl: 'https://your-gymbro-backend.up.railway.app'
#
# Tidak perlu file .env terpisah — Angular menggunakan environment.ts files.
